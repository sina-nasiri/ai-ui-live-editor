APP_NAME="AI UI Live Editor"
APP_ENV=local
APP_KEY=
# Leave this false. The editor receives API keys in request bodies, and Laravel's
# debug page renders request data — turning it on can print a key to the screen.
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=warning

# The editor stores nothing, so it needs no database. File drivers keep setup
# to "composer install && php artisan serve".
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Set a key here and it never leaves your server — the browser never sees it.
# Leave them blank and each visitor supplies their own key in Settings, which
# is what you want for a shared or public instance.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

EDITOR_DEFAULT_PROVIDER=anthropic

# Set to false on a private instance so only the server keys above can be used.
EDITOR_ALLOW_CLIENT_KEYS=true

# ---------------------------------------------------------------------------
# Proxy safety
# ---------------------------------------------------------------------------
# Keep TLS verification on. Turning it off makes every page you load
# interceptable.
EDITOR_VERIFY_SSL=true

# Allowing private networks lets the editor reach localhost, your LAN, and
# cloud metadata endpoints. Only enable it on a single-user machine where you
# genuinely want to edit a local dev server.
EDITOR_ALLOW_PRIVATE_NETWORKS=false

# Comma-separated hostnames. When set, nothing else can be loaded — the
# strongest control available if you expose this instance publicly.
EDITOR_ALLOWED_HOSTS=

EDITOR_PROXY_TIMEOUT=20
EDITOR_PROXY_CACHE_TTL=300
